+import unittest
+from certificate_broker.defaults import apply_public_defaults
+
+
+class CertificateBrokerDefaultsTest(unittest.TestCase):
+    def test_fresh_install_and_existing_empty_config(self):
+        for site in ('https://vision-certi.web.app', 'https://hahattalk-vision-certi.web.app/'):
+            config = {'VISIONCERTI_BASE_URL': site, 'VISIONCERTI_PACS_CLIENT_ID': '',
+                      'VISIONCERTI_PACS_CLIENT_SECRET_FILE': ''}
+            self.assertTrue(apply_public_defaults(config))
+            self.assertEqual(config['VISIONCERTI_PACS_CLIENT_ID'], 'vision-certi-pacs')
+            self.assertEqual(config['VISIONCERTI_PACS_CLIENT_SECRET_FILE'], '')
+            self.assertFalse(apply_public_defaults(config))
+
+    def test_preserves_operator_configuration(self):
+        for config in (
+            {'VISIONCERTI_BASE_URL': 'https://other.example', 'VISIONCERTI_PACS_CLIENT_ID': ''},
+            {'VISIONCERTI_BASE_URL': 'https://vision-certi.web.app', 'VISIONCERTI_PACS_CLIENT_ID': 'other-pacs'},

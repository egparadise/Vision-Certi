+            DB_ECHO=settings.DB_ECHO,
+            DB_PARAMETERS=settings.DB_PARAMETERS,
+            DB_POOL_SIZE=15,
+            DB_MAX_OVERFLOW=5,
+            DB_POOL_TIMEOUT=30,
+            app=app
+        )
+
+        # 관리 데이터베이스 초기화
+        await manageDB.init_app(

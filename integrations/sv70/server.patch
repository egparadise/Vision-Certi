+
+        # 응답 반환
+        return success_response(
+            data={"report_data": report_data},
+            message="Successfully fetched report"
+        )
+
+    except HTTPException as e:
+        # HTTP 예외는 그대로 전달
+        raise e
+    except Exception as e:
+        # 기타 예외 처리

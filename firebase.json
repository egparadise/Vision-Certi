{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Vision-Certi",
        "supportEmail": "egparadise@gmail.com",
        "authorizedRedirectUris": [
          "https://vision-certi.web.app",
          "https://vision-certi.firebaseapp.com",
          "https://hahattalk-vision-certi.web.app",
          "https://hahattalk-vision-certi.firebaseapp.com"
        ]
      }
    }
  },
  "hosting": [
    {
      "target": "vision-certi",
      "public": "apps/web/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/assets/index-*.js", "destination": "/assets/compat.js" },
        { "source": "/assets/index-*.css", "destination": "/assets/compat.css" },
        { "source": "/v1/**", "run": { "serviceId": "vision-certi-api", "region": "asia-northeast3" } }
      ],
      "headers": [
        { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "/assets/index-*.js", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "/assets/index-*.css", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "/v1/**", "headers": [{ "key": "Cache-Control", "value": "no-store, private" }] },
        { "source": "/downloads/vision-certi-bridge-win-x64.zip", "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=vision-certi-bridge-win-x64.zip" }, { "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "/downloads/vision-certi-pacs-window-repair.zip", "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=vision-certi-pacs-window-repair.zip" }] },
        { "source": "/downloads/saintview-pacs-*.exe", "headers": [{ "key": "Content-Disposition", "value": "attachment" }, { "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "**", "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ] }
      ]
    },
    {
      "target": "vision-certi-legacy",
      "public": "apps/web/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/assets/index-*.js", "destination": "/assets/compat.js" },
        { "source": "/assets/index-*.css", "destination": "/assets/compat.css" },
        { "source": "/v1/**", "run": { "serviceId": "vision-certi-api", "region": "asia-northeast3" } }
      ],
      "headers": [
        { "source": "/downloads/saintview-pacs-*.exe", "headers": [{ "key": "Content-Disposition", "value": "attachment" }, { "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "/assets/index-*.js", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "/assets/index-*.css", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
        { "source": "/v1/**", "headers": [{ "key": "Cache-Control", "value": "no-store, private" }] },
        { "source": "**", "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ] }
      ]
    }
  ]
}

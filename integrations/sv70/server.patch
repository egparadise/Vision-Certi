+                                    "documentSha256": r["payload"]["contentSha256"],
+                                    "signerId": r["payload"]["doctorId"], "signature": r["signature"]})
+        return self._json(404, {"code": "NOT_FOUND"})
+
+    @staticmethod
+    def _json(status, body):
+        return RawResponse(status, json.dumps(body).encode())

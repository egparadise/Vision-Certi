# Apply to the PACS API process environment (not the browser).
VISION_CERTI_INTEGRATION_ENABLED=true
VISION_CERTI_BASE_URL=https://192.168.45.160:5174
VISION_CERTI_PUBLIC_BASE_URL=https://192.168.45.160:5174
VISION_CERTI_CLIENT_ID=pacs-sv70
VISION_CERTI_TENANT_ID=demo-hospital-a
VISION_CERTI_AUDIENCE=vision-certi:pacs-integration:v1
VISION_CERTI_CLIENT_SECRET_FILE=/etc/vision-certi/sv70-integration.secret
VISION_CERTI_CA_BUNDLE=/etc/vision-certi/vision-certi-lan-ca.cer
# Replace with actual PACS administrator user_idx values before enabling.
VISION_CERTI_LINK_ADMIN_USER_IDX=REPLACE_WITH_ADMIN_USER_IDX
VISION_CERTI_CONNECT_TIMEOUT=3
VISION_CERTI_READ_TIMEOUT=10
VISION_CERTI_SESSION_MAX_MINUTES=60

# Copy reviewed values into the deployment environment, then restart/rebuild the web app.
# Public configuration only. Never put signing keys, passwords or client secrets here.
VITE_CERT_INSTALLER_NAME=
# Vendor HTTPS installer URL, or a same-origin relative URL to the approved installer.
VITE_CERT_INSTALLER_URL=
# SHA-256 of the approved installer. This is release metadata; it does not replace code signing.
VITE_CERT_INSTALLER_SHA256=
# Manual challenge/PEM/signature diagnostics are disabled by default and unavailable in production builds.
VITE_CERTIFICATE_DIAGNOSTICS=false

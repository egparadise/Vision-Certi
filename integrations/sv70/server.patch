+# 유틸리티 함수들
+def is_valid_phone(number):
+    """전화번호 형식 검증"""
+    pattern = r'^01[016789]\d{7,8}$'
+    return bool(re.match(pattern, number))
+
+
+def safe_convert(value):
+    """안전한 정수 변환"""
+    if value == '' or value is None:
+        return None
+    try:
+        return int(value)
+    except ValueError:
+        return None

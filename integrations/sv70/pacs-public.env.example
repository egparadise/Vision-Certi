# External PACS server process environment. Replace institution-specific values before use.
# Public endpoint runs independently of the Vision-Certi developer PC.
VISION_CERTI_INTEGRATION_ENABLED=true
VISION_CERTI_BASE_URL=https://vision-certi.web.app
VISION_CERTI_PUBLIC_BASE_URL=https://vision-certi.web.app
VISION_CERTI_CLIENT_ID=vision-certi-pacs
# Register the actual medical institution before setting this value; inviz is only the current pilot scope.
VISION_CERTI_TENANT_ID=REPLACE_WITH_REGISTERED_INSTITUTION_ID
VISION_CERTI_AUDIENCE=vision-certi:pacs-integration:v1
VISION_CERTI_CLIENT_SECRET_FILE=/etc/vision-certi/pacs-integration.secret
# Use the OS trust store for the public HTTPS certificate.
VISION_CERTI_LINK_ADMIN_USER_IDX=REPLACE_WITH_ADMIN_USER_IDX
VISION_CERTI_CONNECT_TIMEOUT=3
VISION_CERTI_READ_TIMEOUT=10
VISION_CERTI_SESSION_MAX_MINUTES=120

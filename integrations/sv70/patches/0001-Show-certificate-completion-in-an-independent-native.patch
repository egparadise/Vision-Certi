+function showPendingStatus(popup: Window, title: string, message: string) {
+  try {
+    // Only write to our own, still blank reservation. Never replace a remote page.
+    if (popup.location.href !== 'about:blank' || !popup.document) return;
+    const doc = popup.document;
+    doc.title = '공동인증서 — Vision-Certi';
+    const panel = doc.createElement('main');
+    panel.style.cssText = 'max-width:520px;margin:48px auto;padding:32px;font:18px/1.7 sans-serif;color:#153153';
+    const heading = doc.createElement('h1'); heading.textContent = title;
+    const detail = doc.createElement('p'); detail.textContent = message;
+    const help = doc.createElement('p'); help.textContent = '이 창은 오른쪽 위 X로 닫을 수 있습니다.';
+    panel.append(heading, detail, help);
+    doc.body.replaceChildren(panel);
+  } catch { /* The remote proof page owns its own loading/error state. */ }
+}
+
+function showPendingFailure(popup: Window) {

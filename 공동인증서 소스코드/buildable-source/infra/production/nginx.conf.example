# Replace names and certificate paths; serve apps/web/dist at /var/www/vision-certi.
# The API binds to loopback. Do not expose its HTTP port to the network.
server {
    listen 80;
    server_name auth.example.com;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name auth.example.com;
    ssl_certificate /etc/vision-certi/tls/fullchain.pem;
    ssl_certificate_key /etc/vision-certi/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/vision-certi;
    index index.html;
    client_max_body_size 21m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # same-origin-allow-popups is required for the authorized PACS/OIDC popup bridge.
    add_header Cross-Origin-Opener-Policy same-origin-allow-popups always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location /v1/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_no_cache 1;
        # Do not include authorization headers, request bodies, or query tokens in access logs.
        access_log off;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control no-cache;
    }
}

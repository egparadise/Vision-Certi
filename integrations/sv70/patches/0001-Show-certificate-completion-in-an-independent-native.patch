@@ -0,0 +1,19 @@
+"""Public integration defaults; never provisions signing credentials."""
+DEFAULT_SITE = 'https://vision-certi.web.app'
+DEFAULT_CLIENT_ID = 'vision-certi-pacs'
+KNOWN_SITES = {DEFAULT_SITE, 'https://vision-certi.firebaseapp.com',
+               'https://hahattalk-vision-certi.web.app', 'https://hahattalk-vision-certi.firebaseapp.com'}
+
+
+def apply_public_defaults(config):
+    """Fill the missing audience only for the supplied Vision-Certi deployment.
+
+    Custom endpoints and existing IDs belong to their operator. In particular,
+    an API override can represent a different tenant even with our hosted UI.
+    """
+    base = config.get('VISIONCERTI_BASE_URL', '').rstrip('/')
+    api = config.get('VISIONCERTI_API_BASE_URL', '').rstrip('/')
+    if base in KNOWN_SITES and (not api or api in KNOWN_SITES) and not config.get('VISIONCERTI_PACS_CLIENT_ID'):
+        config['VISIONCERTI_PACS_CLIENT_ID'] = DEFAULT_CLIENT_ID
+        return True
+    return False

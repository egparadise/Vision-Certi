diff --git a/client/src-tauri/src/domains/certificate.rs b/client/src-tauri/src/domains/certificate.rs
index 4aaf333..1d0b2b3 100644
--- a/client/src-tauri/src/domains/certificate.rs
+++ b/client/src-tauri/src/domains/certificate.rs
@@ -3,6 +3,8 @@ use std::sync::atomic::{AtomicU64, Ordering};
 use tauri::{AppHandle, WebviewUrl, WebviewWindowBuilder};
 use tauri::webview::{NewWindowFeatures, NewWindowResponse};
 use tauri::Manager;
+use tauri::webview::PageLoadEvent;
+use serde_json::Value;
 
 pub fn start_local_broker(app: &AppHandle) {
     #[cfg(target_os = "windows")]
@@ -23,6 +25,57 @@ pub fn start_local_broker(app: &AppHandle) {
 
 static NEXT_POPUP: AtomicU64 = AtomicU64::new(1);
 
+fn matches_proof_popup(url: &url::Url, origin: &str, nonce: &str) -> bool {
+    if url.scheme() != "https" || url.origin().ascii_serialization() != origin { return false; }
+    let Some((route, query)) = url.fragment().and_then(|value| value.split_once('?')) else { return false; };
+    route == "/certificates/pacs-proof" &&
+        url::form_urlencoded::parse(query.as_bytes()).filter(|(key, _)| key == "nonce")
+            .map(|(_, value)| value == nonce).collect::<Vec<_>>() == vec![true]
+}
+
+/// Presentation only. This never creates a certificate receipt or PACS session.
+/// The main renderer calls it after validating the server popup's message.
+pub fn show_complete(app: &AppHandle, args: &[Value]) -> Result<(), String> {
+    let value = args.first().ok_or("Missing completion context")?;
+    let nonce = value.get("nonce").and_then(Value::as_str).ok_or("Missing nonce")?;
+    let origin = value.get("origin").and_then(Value::as_str).ok_or("Missing origin")?;
+    if nonce.len() != 64 || !nonce.bytes().all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase()) {
+        return Err("Invalid nonce".into());
+    }
+    let original = app.webview_windows().into_iter().find_map(|(label, window)| {
+        if label.starts_with("certificate-popup-") && window.url().ok()
+            .map(|url| matches_proof_popup(&url, origin, nonce)).unwrap_or(false) { Some(window) } else { None }
+    }).ok_or("Matching certificate popup no longer exists")?;
+    let original_label = original.label().to_string();
+    let completion_label = format!("certificate-complete-{}", NEXT_POPUP.fetch_add(1, Ordering::Relaxed));
+    let parent = app.clone();
+    let ready = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+    // No window_features/opener and no IPC capabilities: the result page survives
+    // the original remote WebView's closure, navigation, network or script failure.
+    WebviewWindowBuilder::new(app, completion_label, WebviewUrl::App("certificate-complete.html".into()))
+        .title("인증 완료 — Vision-Certi")
+        .inner_size(560.0, 360.0).min_inner_size(480.0, 300.0)
+        .center().visible(false)
+        .on_navigation(|url| matches!(url.scheme(), "http" | "https" | "tauri") &&
+            matches!(url.host_str(), Some("tauri.localhost") | Some("localhost")) &&
+            url.path() == "/certificate-complete.html")
+        .on_new_window(|_, _| NewWindowResponse::Deny)
+        .on_page_load(move |webview, payload| {
+            if payload.event() == PageLoadEvent::Finished && payload.url().path() == "/certificate-complete.html" &&
+                !ready.swap(true, Ordering::AcqRel) {
+                if let Some(window) = parent.get_webview_window(webview.label()) {
+                    let _ = window.show();
+                    // Destroy the native frame, never window.close() from web content.
+                    if let Some(old) = parent.get_webview_window(&original_label) { let _ = old.destroy(); }
+                    let _ = window.set_focus();
+                    log::info!("[certificate] independent completion displayed; app={}", parent.package_info().version);
+                }
+            }
+        })
+        .build().map_err(|error| format!("Completion window could not open: {error}"))?;
+    Ok(())
+}
+
 pub fn popup_handler(app: AppHandle) -> impl Fn(url::Url, NewWindowFeatures) -> NewWindowResponse<tauri::Wry> + Send + 'static {
     move |url, features| {
         if url.as_str() != "about:blank" && url.scheme() != "https" {
@@ -50,3 +103,21 @@ pub fn popup_handler(app: AppHandle) -> impl Fn(url::Url, NewWindowFeatures) ->
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn completion_matches_only_the_requesting_proof_popup() {
+        let nonce = "a".repeat(64);
+        let address = format!("https://vision-certi.web.app/#/certificates/pacs-proof?nonce={nonce}&audience=pacs");
+        let url = url::Url::parse(&address).unwrap();
+        assert!(matches_proof_popup(&url, "https://vision-certi.web.app", &nonce));
+        assert!(!matches_proof_popup(&url, "https://other.example", &nonce));
+        assert!(!matches_proof_popup(&url, "https://vision-certi.web.app", &"b".repeat(64)));
+        for invalid in [address.replace("https:", "http:"), address.replace("pacs-proof", "login"),
+            format!("{address}&nonce={nonce}")] {
+            assert!(!matches_proof_popup(&url::Url::parse(&invalid).unwrap(), "https://vision-certi.web.app", &nonce));
+        }
+    }
+}
